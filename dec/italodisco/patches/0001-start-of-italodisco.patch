diff --git a/dec/selector.s b/dec/selector.s
new file mode 100644
index 0000000..ae63516
--- /dev/null
+++ b/dec/selector.s
@@ -0,0 +1,138 @@
+;-------------------------------------------------------------------
+; selector - RESISTANCE / Passione Amiga Day 2026
+;
+; Runs the swaptro as a subroutine, reads the return code it leaves
+; in D0, unloads it, then loads and runs the program that the code
+; selects, and finally reboots.
+;
+; Nothing resident is needed: the swaptro is a child of this program,
+; so its exit code comes straight back in D0.
+;
+; Only dos.library LoadSeg/UnLoadSeg and exec are used, so this works
+; on every Kickstart from 1.2 upwards. No C:, no L:, no RAM:.
+;-------------------------------------------------------------------
+
+SYSBASE		EQU	$4
+
+; exec
+LVO_OPENLIB	EQU	-552
+LVO_CLOSELIB	EQU	-414
+LVO_SUPERVISOR	EQU	-30
+LVO_DISABLE	EQU	-120
+LVO_COLDREBOOT	EQU	-726
+; dos
+LVO_LOADSEG	EQU	-150
+LVO_UNLOADSEG	EQU	-156
+
+	SECTION	"CODE",CODE
+
+START:
+	movea.l	SYSBASE,a6
+	lea	DOSNAME(pc),a1
+	moveq	#0,d0
+	jsr	LVO_OPENLIB(a6)
+	move.l	d0,DOSBASE
+	bne.s	.havedos
+	moveq	#20,d0			; RETURN_FAIL
+	rts
+.havedos:
+	lea	SWAPTRO(pc),a0
+	bsr.w	RUNPROG			; D0 = code chosen with F1..F10
+	tst.l	d0
+	ble.s	.nothing		; 0 or a load failure: just leave
+	subq.l	#1,d0
+	cmpi.l	#NPROGS,d0
+	bcc.s	.nothing		; out of table
+	lsl.l	#2,d0
+	lea	PROGTAB(pc),a0
+	movea.l	0(a0,d0.l),a0
+	tst.b	(a0)
+	beq.s	.nothing		; empty slot
+	bsr.w	RUNPROG
+	bsr.w	REBOOT			; does not return
+.nothing:
+	movea.l	SYSBASE,a6
+	movea.l	DOSBASE(pc),a1
+	jsr	LVO_CLOSELIB(a6)
+	moveq	#0,d0
+	rts
+
+;-------------------------------------------------------------------
+; RUNPROG - A0 = file name. Loads it, calls it with the CLI register
+; convention (D0 = command line length, A0 = command line), unloads
+; it again and returns its exit code in D0, or -1 if it would not load.
+;
+; The unload happens before the caller loads anything else, which is
+; the whole point: the swaptro is out of memory before the next
+; program is read in.
+;-------------------------------------------------------------------
+RUNPROG:
+	movem.l	d2-d7/a2-a6,-(a7)
+	movea.l	DOSBASE(pc),a6
+	move.l	a0,d1
+	jsr	LVO_LOADSEG(a6)
+	move.l	d0,d7			; BPTR to the segment list
+	beq.s	RP_FAIL
+	lsl.l	#2,d0			; BPTR -> byte address
+	addq.l	#4,d0			; skip the next-segment pointer
+	movea.l	d0,a4
+	lea	EMPTYARG(pc),a0
+	moveq	#1,d0			; length of the empty command line
+	jsr	(a4)			; run it
+	move.l	d0,d6			; keep the exit code
+	movea.l	DOSBASE(pc),a6
+	move.l	d7,d1
+	jsr	LVO_UNLOADSEG(a6)
+	move.l	d6,d0
+	bra.s	RP_OUT
+RP_FAIL:
+	moveq	#-1,d0
+RP_OUT:
+	movem.l	(a7)+,d2-d7/a2-a6
+	rts
+
+;-------------------------------------------------------------------
+; REBOOT - ColdReboot() when it exists (KS 2.0+), otherwise the
+; classic supervisor RESET for 1.2 and 1.3.
+;-------------------------------------------------------------------
+REBOOT:
+	movea.l	SYSBASE,a6
+	cmpi.w	#36,20(a6)		; lib_Version
+	bcs.s	RB_OLD
+	jsr	LVO_COLDREBOOT(a6)
+	rts
+RB_OLD:
+	jsr	LVO_DISABLE(a6)
+	lea	RB_SUPER(pc),a5
+	jsr	LVO_SUPERVISOR(a6)
+	rts
+	cnop	0,4
+RB_SUPER:
+	lea	$01000000,a0
+	sub.l	-$14(a0),a0		; ROM base
+	movea.l	4(a0),a0		; initial PC from the reset vector
+	subq.l	#2,a0
+	reset
+	jmp	(a0)
+
+;-------------------------------------------------------------------
+DOSNAME:
+	dc.b	"dos.library",0
+EMPTYARG:
+	dc.b	10,0			; an empty CLI command line is just LF
+SWAPTRO:
+	dc.b	"6_ks13",0
+NAME1:	dc.b	"horror13",0		; F1
+NAME2:	dc.b	"",0			; F2  - free slot
+NAME3:	dc.b	"",0			; F3  - free slot
+	even
+
+PROGTAB:
+	dc.l	NAME1
+	dc.l	NAME2
+	dc.l	NAME3
+NPROGS	EQU	(*-PROGTAB)/4
+
+DOSBASE:
+	dc.l	0
+	END
\ No newline at end of file
diff --git a/dec/startup-sequence b/dec/startup-sequence
new file mode 100644
index 0000000..99716fc
--- /dev/null
+++ b/dec/startup-sequence
@@ -0,0 +1 @@
+selector
\ No newline at end of file
