Subject: [PATCH] start of italodisco

---
 dec/6.s              | 117 +++++++++++++++++++++++++++++-------
 dec/Makefile         |   5 +-
 dec/horror13         | Bin 0 -> 345992 bytes
 dec/selector.s       | 138 +++++++++++++++++++++++++++++++++++++++++++
 dec/startup-sequence |   1 +
 5 files changed, 239 insertions(+), 22 deletions(-)
 create mode 100755 dec/horror13
 create mode 100644 dec/selector.s
 create mode 100644 dec/startup-sequence

diff --git a/dec/6.s b/dec/6.s
index f9fe3e9..d042ef5 100644
--- a/dec/6.s
+++ b/dec/6.s
@@ -19,11 +19,26 @@ AUD2VOL	EQU	$DFF0C8
 AUD3LCH	EQU	$DFF0D0
 AUD3VOL	EQU	$DFF0D8
 
+; --- tastiera ---
+CIAASDR		EQU	$BFEC01
+KEY_SPACE	EQU	$40
+KEY_ESC		EQU	$45
+KEY_F1		EQU	$50		; F1..F10 = $50..$59
+KEY_F10		EQU	$59
+
 	SECTION	"CODE",CODE_C
 
 	;ORG	$48000
 
 SECSTRT_0:
+	move.l	a7,MAINSP		; save current stack pointer
+	clr.b	KEYACTION
+	clr.b	CHOICE
+	move.b	CIAASDR,d0		; ignora il tasto gia' presente nel registro
+	not.b	d0
+	ror.b	#1,d0
+	move.b	d0,LASTRAW
+
 	JSR	SUB_49BE0		;48004: 4eb900049be0 remmed by me
 	BSR.W	CLEARBPL		;48000: 61000818
 	BSR.W	SUB_48204		;4800a: 610001f8
@@ -90,9 +105,11 @@ SECSTRT_0:
 	BSR.W	SUB_48314		;480e8: 6100022a
 	BSR.W	LAB_4826A		;480ec: 6100017c
 	BSR.W	SUB_48106		;480f0: 61000014
+DEMOEND:
 	BSR.W	CLEARBPL		;480f4: 61000724
-	;MOVE.W	#$0000,LAB_486A6	;480f8: 33fc0000000486a6
 	BSR.W	SUB_482D6		;48100: 610001d4
+	moveq	#0,d0
+	move.b	CHOICE,d0		; 0 = end with no key press, 1..10 = F1..F10
 	RTS				;48104: 4e75
 SUB_48106:
 	;ADDI.W	#$0028,LAB_486A6	;48106: 06790028000486a6
@@ -444,6 +466,7 @@ LAB_4832C:
 	CMPI.B	#$20,D0			;4832e: 0c000020
 	BEQ.S	LAB_4837A		;48332: 6746
 	JSR	WAITVBLANK		;48334: 4eb90004882e
+	BSR.W	CHECKKEYS
 	bsr.w SCROLL_CANVAS
 	;ADDI.W	#$0028,LAB_4868E	;4833a: 067900280004868e
 	;ADDI.W	#$0028,LAB_48696	;48342: 0679002800048696
@@ -688,6 +719,50 @@ LAB_48810:
 	DC.W	$4ef9			;48814
 OLD_INT3:
 	DS.L	1			;48816
+; ==================================================================
+; CHECKKEYS - CIA-A reading.
+; F1..F10       ->  1..10 in CHOICE
+; ==================================================================
+CHECKKEYS:
+	movem.l	d0-d1,-(a7)
+	move.b	CIAASDR,d0
+	not.b	d0
+	ror.b	#1,d0
+	cmp.b	LASTRAW,d0
+	beq.s	CK_DONE
+	move.b	d0,LASTRAW
+	btst	#7,d0
+	bne.s	CK_DONE
+	andi.b	#$7f,d0
+	cmpi.b	#KEY_F1,d0
+	blo.s	CK_NOTFUNC
+	cmpi.b	#KEY_F10,d0
+	bhi.s	CK_NOTFUNC
+	subi.b	#KEY_F1-1,d0		; F1 -> 1 ... F10 -> 10
+	move.b	d0,CHOICE
+	movea.l	MAINSP,a7		; trash stack (put the old one that we had at the beginning)
+	bra.w	DEMOEND
+CK_NOTFUNC:
+	;cmpi.b	#KEY_SPACE,d0
+	;beq.s	CK_NEXT
+	cmpi.b	#KEY_ESC,d0
+	bne.s	CK_DONE
+CK_NEXT:
+	move.b	#1,KEYACTION		; avanti di una pagina
+CK_DONE:
+	movem.l	(a7)+,d0-d1
+	rts
+
+LASTRAW:
+	dc.b	0
+KEYACTION:
+	dc.b	0
+CHOICE:
+	dc.b	0
+	even
+MAINSP:
+	dc.l	0
+
 CLEARBPL:
 	LEA	BITPLANES,A4		;4881a: 49f900070000
 	LEA	BITPLANES+$F000,A5		;48820: 4bf90007f000
@@ -737,10 +812,10 @@ STAGE0:
 	dc.b	"                                        "	; $489B4
 	dc.b	"            PLEASE REMEMBER             "	; $489DC
 	dc.b	"                                        "	; $48A04
-	dc.b	"           LEFT MOUSE BUTTON            "	; $48A2C
+	dc.b	"            PRESS SPACE BAR             "	; $48A2C
 	dc.b	"                                        "	; $48A54
 	dc.b	"       TO PASS EVERY TEXT SCREEN        "	; $48A7C
-	dc.b	"                                        "	; $48AA4
+	dc.b	"        F1 TO START THE OTHER ONE       "	; $48AA4
 	dc.b	0						; $48ACC  page end
 
 ; ---------------- STAGE1: page 2, 16 rows ----------------
diff --git a/dec/Makefile b/dec/Makefile
index 7b7a1b0..5cb5389 100644
--- a/dec/Makefile
+++ b/dec/Makefile
@@ -5,8 +5,11 @@ all:
 	vasmm68k_mot -devpac -nocase -Fhunk   -o ./6ks13.o ./6.s
 	vlink -bamigahunk -o ./6_ks13 -s  ./6ks13.o
 
+	vasmm68k_mot -devpac -nocase -Fhunk   -o ./selector.o ./selector.s
+	vlink -bamigahunk -o ./selector -s  ./selector.o
+
 floppy:
-	exe2adf -i 6_ks13 -a stage-swaptro_13.adf
+	gadf -i selector -S startup-sequence 6_ks13 horror13
 
 patch:
 	git apply patches/0001-Fix-colors-in-bottom-bar.patch
