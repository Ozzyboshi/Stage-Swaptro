+	subi.b	#KEY_F1-1,d0		; F1 -> 1 ... F10 -> 10
+	move.b	d0,CHOICE
+	movea.l	MAINSP,a7		; trash stack (put the old one that we had at the beginning)
+	bra.w	DEMOEND
+CK_NOTFUNC:
+	cmpi.b	#KEY_SPACE,d0
+	beq.s	CK_NEXT
+	cmpi.b	#KEY_ESC,d0
+	bne.s	CK_DONE
+CK_NEXT:
+	move.b	#1,KEYACTION		; avanti di una pagina
+CK_DONE:
+	movem.l	(a7)+,d0-d1
+	rts
+
+LASTRAW:
+	dc.b	0
+KEYACTION:
+	dc.b	0
+CHOICE:
+	dc.b	0
+	even
+MAINSP:
+	dc.l	0
+
