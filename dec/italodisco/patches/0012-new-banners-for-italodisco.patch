+; ==================================================================
+; CHECKKEYS - CIA-A reading.
+; F1..F10       ->  1..10 in CHOICE
+; ==================================================================
+CHECKKEYS:
+	movem.l	d0-d1,-(a7)
+	move.b	CIAASDR,d0
+	not.b	d0
+	ror.b	#1,d0
+	cmp.b	LASTRAW,d0
