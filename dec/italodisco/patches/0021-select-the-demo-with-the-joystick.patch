@@ -734,6 +739,141 @@ CK_DONE:
 	movem.l	(a7)+,d0-d1
 	rts
 
+; ==================================================================
+; CHECKJOY - joystick in port 2, a CD32 pad too (red button = fire).
+; Menu page: up/down move the bar, fire starts that demo, right goes
+; on to the next page like SPACE. Other pages: fire or right go on,
+; also while the page is still being typed, as SPACE does. While the
+; menu is typed the joystick is ignored (a fire meant for the menu
+; would otherwise skip it). Up/down repeat while held.
+; ==================================================================
+JOY_UP		EQU	0
+JOY_DOWN	EQU	1
+JOY_RIGHT	EQU	3
+JOY_FIRE	EQU	4
+JOY_DELAY	EQU	12		; loop passes before the first repeat
+JOY_RATE	EQU	5		; loop passes between repeats
+
+CHECKJOY:
+	movem.l	d0-d2,-(a7)
+	moveq	#0,d1			; D1 = what is held now
+	move.w	JOY1DAT,d0
+	btst	#1,d0
+	beq.s	.noright
+	bset	#JOY_RIGHT,d1
+.noright:
+	move.w	d0,d2
+	lsr.w	#1,d2
+	eor.w	d0,d2			; bit 0 = down, bit 8 = up
+	btst	#0,d2
+	beq.s	.nodown
+	bset	#JOY_DOWN,d1
+.nodown:
+	btst	#8,d2
+	beq.s	.noup
+	bset	#JOY_UP,d1
+.noup:
+	btst	#7,EXT_BFE001		; /FIR1, active low
+	bne.s	.nofire
+	bset	#JOY_FIRE,d1
+.nofire:
+	move.b	JOYLAST,d2
+	move.b	d1,JOYLAST
+	not.b	d2
+	and.b	d1,d2			; D2 = just pressed
+	move.b	d1,d0
+	andi.b	#(1<<JOY_UP)|(1<<JOY_DOWN),d0
+	beq.s	.norep
+	tst.b	d2
+	beq.s	.held
+	move.b	#JOY_DELAY,JOYREP
+	bra.s	.norep
+.held:
+	subq.b	#1,JOYREP
+	bne.s	.norep
+	move.b	#JOY_RATE,JOYREP
+	or.b	d0,d2			; repeat up/down
+.norep:
+	tst.b	MENUON
+	beq.s	.other			; 0: other page
+	bpl.s	.done			; 1: menu being typed
+	btst	#JOY_FIRE,d2
+	bne.s	.fire
+	btst	#JOY_UP,d2
+	bne.s	.up
+	btst	#JOY_DOWN,d2
+	bne.s	.down
+.other:
+	andi.b	#(1<<JOY_FIRE)|(1<<JOY_RIGHT),d2
+	beq.s	.done
+	move.b	#1,KEYACTION		; next page
+.done:
+	movem.l	(a7)+,d0-d2
+	rts
+.up:
+	bsr.w	BARTOGGLE		; off
+	subq.b	#1,JOYSEL
+	bpl.s	.moved
+	move.b	#MENU_ITEMS-1,JOYSEL
+	bra.s	.moved
+.down:
+	bsr.w	BARTOGGLE		; off
+	addq.b	#1,JOYSEL
+	cmpi.b	#MENU_ITEMS,JOYSEL
+	blo.s	.moved
+	clr.b	JOYSEL
+.moved:
+	bsr.w	BARTOGGLE		; on, on the new row
+	bra.s	.done
+.fire:
+	moveq	#0,d0
+	move.b	JOYSEL,d0
+	addq.b	#1,d0			; same code as F1..F9
+	move.b	d0,CHOICE
+	movea.l	MAINSP,a7		; trash stack, as CHECKKEYS does
+	bra.w	DEMOEND
+
+; MENUWAIT - wait on the menu page with the bar shown
+MENUWAIT:
+	bsr.s	BARTOGGLE
+	st	MENUON
+	bsr.w	LAB_4826A
+	clr.b	MENUON
+					; and on into BARTOGGLE: the page
+					; scrolls out without the bar
+
+; BARTOGGLE - flip the 5th bitplane under the text of the selected
+; menu row, inside the frame: there the canvas shows through in
+; colours 16-23 and the text (4th bitplane) in colours 24-31.
+MENU_ROW	EQU	4		; text row of F1 in STAGE0
+MENU_ITEMS	EQU	9		; F1..F9
+BARTOGGLE:
+	movem.l	d0-d1/a0,-(a7)
+	moveq	#0,d0
+	move.b	JOYSEL,d0
+	addq.w	#MENU_ROW,d0
+	mulu	#$140,d0		; 8 lines of 40 bytes per text row
+	lea	BITPLANES+$2800+1,a0	; 5th bitplane, column 1
+	adda.l	d0,a0
+	moveq	#8-1,d1
+.line:
+	moveq	#38-1,d0		; columns 1..38
+.col:
+	not.b	(a0)+
+	dbf	d0,.col
+	addq.l	#2,a0
+	dbf	d1,.line
+	movem.l	(a7)+,d0-d1/a0
+	rts
+
+JOYLAST:
+	dc.b	0
+JOYREP:
+	dc.b	0
+JOYSEL:
+	dc.b	0			; selected menu row, 0 = F1
+MENUON:
+	dc.b	0			; 0 other page, 1 menu typed, -1 menu
 LASTRAW:
 	dc.b	0
 KEYACTION:
-- 
