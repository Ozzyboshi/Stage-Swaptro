 KEY_SPACE	EQU	$40
 KEY_ESC		EQU	$45
 KEY_F1		EQU	$50		; F1..F10 = $50..$59
@@ -38,6 +39,7 @@ SECSTRT_0:
 	not.b	d0
 	ror.b	#1,d0
 	move.b	d0,LASTRAW
+	st	JOYLAST			; joystick: wait for a release first
 
 	JSR	SUB_49BE0		;48004: 4eb900049be0 remmed by me
 	BSR.W	CLEARBPL		;48000: 61000818
@@ -46,8 +48,9 @@ SECSTRT_0:
 PAGELOOP:
 	;MOVEA.L	#$0004884c,A1		;48010: 227c0004884c
 	movea.l #STAGE0,A1		;48010: 227c0004884c
+	move.b	#1,MENUON		; menu being typed: joystick ignored
 	BSR.W	SUB_48314		;48016: 610002fc
-	BSR.W	LAB_4826A		;4801a: 6100024e
+	BSR.W	MENUWAIT		; LAB_4826A with the joystick bar
 	BSR.W	SUB_48106		;4801e: 610000e6
 	BSR.W	CLEARBPL		;48022: 610007f6
 	;MOVE.W	#$0000,LAB_486A6	;48026: 33fc0000000486a6
@@ -408,6 +411,7 @@ LAB_4826A:
 LAB_482C2:
 	BSR.W	WAITVBLANK		;482c2: 6100056a
 	BSR.W	CHECKKEYS
+	BSR.W	CHECKJOY
 	TST.B	KEYACTION
 	BEQ.W	LAB_4826A		;no key pressed, continue
 	CLR.B	KEYACTION
@@ -445,6 +449,7 @@ LAB_4832C:
 	BEQ.S	LAB_4837A		;48332: 6746
 	JSR	WAITVBLANK		;48334: 4eb90004882e
 	BSR.W	CHECKKEYS
+	BSR.W	CHECKJOY
 	bsr.w SCROLL_CANVAS
 	;ADDI.W	#$0028,LAB_4868E	;4833a: 067900280004868e
 	;ADDI.W	#$0028,LAB_48696	;48342: 0679002800048696
@@ -615,8 +620,8 @@ LAB_4867E:
 	DC.L	$01880fe4,$018a0fbe,$018c0abc,$018e068a
 	DC.L	$01900FFF,$01920FFF,$01940FFF,$01960fff
 	DC.L	$01980FFF,$019a0fff,$019c0FFF,$019e0fff
-	DC.L	$01a00aaa,$01a20d0e,$01a40fbf,$01a60fef
-	DC.L	$01a80ddd,$01aa0fff,$01ac0c0d,$01ae0fcf
