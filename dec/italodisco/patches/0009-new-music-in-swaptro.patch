+; ==================================================================
+; CHECKKEYS - lettura non distruttiva del registro seriale del CIA-A.
+; Il gestore di tastiera del sistema continua a fare l'handshake, noi
+; ci limitiamo a sbirciare l'ultimo codice ricevuto.
+;   bit 7 = 1 -> rilascio      bit 6..0 = raw key code
+;
+; SPAZIO o ESC  -> avanza di una pagina
+; F1..F10       -> memorizza 1..10 in CHOICE ed esce dalla demo
+; ==================================================================
+CHECKKEYS:
+	movem.l	d0-d1,-(a7)
+	move.b	CIAASDR,d0
+	not.b	d0
+	ror.b	#1,d0
+	cmp.b	LASTRAW,d0
+	beq.s	CK_DONE			; niente di nuovo
+	move.b	d0,LASTRAW
+	btst	#7,d0
+	bne.s	CK_DONE			; e' un rilascio, ignora
+	andi.b	#$7f,d0
+	cmpi.b	#KEY_F1,d0
+	blo.s	CK_NOTFUNC
+	cmpi.b	#KEY_F9,d0
+	bhi.s	CK_NOTFUNC
+	subi.b	#KEY_F1-1,d0		; F1 -> 1 ... F9 -> 9
+	move.b	d0,CHOICE
+	movea.l	MAINSP,a7		; butta via tutto lo stack
+	bra.w	DEMOEND
+CK_NOTFUNC:
+	cmpi.b	#KEY_SPACE,d0
+	beq.s	CK_NEXT
+	cmpi.b	#KEY_ESC,d0
+	bne.s	CK_DONE
+CK_NEXT:
+	move.b	#1,KEYACTION		; avanti di una pagina
+CK_DONE:
+	movem.l	(a7)+,d0-d1
+	rts
+
+LASTRAW:
+	dc.b	0
+KEYACTION:
+	dc.b	0
+CHOICE:
+	dc.b	0
+	even
+MAINSP:
+	dc.l	0
+
 CLEARBPL:
 	LEA	BITPLANES,A4		;4881a: 49f900070000
 	LEA	BITPLANES+$F000,A5		;48820: 4bf90007f000
