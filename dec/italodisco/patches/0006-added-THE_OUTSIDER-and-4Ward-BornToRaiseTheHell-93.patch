From 7cd3b54719e81e5b3ad1dc2806de5586b8c49c6c Mon Sep 17 00:00:00 2001
From: Alessio Garzi <agarzi@sipwise.com>
Date: Mon, 24 Aug 2026 18:13:15 +0200
Subject: [PATCH] added THE_OUTSIDER and 4Ward-BornToRaiseTheHell - 93

---
 dec/Makefile   | 4 +++-
 dec/selector.s | 6 +++---
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/dec/Makefile b/dec/Makefile
index 7669e26..818f790 100644
--- a/dec/Makefile
+++ b/dec/Makefile
@@ -12,7 +12,9 @@ floppy:
 	mkdir -p compressedtmp
 	Shrinkler --flash DFF180 6_ks13 compressedtmp/6_ks13
 	Shrinkler --flash DFF180 horror13 compressedtmp/horror13
-	gadf -i selector -S startup-sequence compressedtmp/6_ks13 compressedtmp/horror13
+	Shrinkler --flash DFF180 THE_OUTSIDER compressedtmp/THE_OUTSIDER
+	Shrinkler --flash DFF180 '4Ward-BornToRaiseTheHell - 93' 'compressedtmp/4Ward-BornToRaiseTheHell - 93'
+	gadf -i selector -S startup-sequence compressedtmp/6_ks13 compressedtmp/horror13 compressedtmp/THE_OUTSIDER 'compressedtmp/4Ward-BornToRaiseTheHell - 93'
 	rm -rf compressedtmp
 
 patch:
diff --git a/dec/selector.s b/dec/selector.s
index ae63516..eb6a7ab 100644
--- a/dec/selector.s
+++ b/dec/selector.s
@@ -123,9 +123,9 @@ EMPTYARG:
 SWAPTRO:
 	dc.b	"6_ks13",0
 NAME1:	dc.b	"horror13",0		; F1
-NAME2:	dc.b	"",0			; F2  - free slot
-NAME3:	dc.b	"",0			; F3  - free slot
-	even
+NAME2:	dc.b	"THE_OUTSIDER",0			; F2  - free slot
+NAME3:	dc.b	"4Ward-BornToRaiseTheHell - 93",0			; F3  - free slot
+		even
 
 PROGTAB:
 	dc.l	NAME1
